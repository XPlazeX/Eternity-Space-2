    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u0420\u0435\u0431\u044F\u0442\u0430, \u043E\u0441\u0435\u043D\u044C\u044E
    2024 \u044F \u0443\u0445\u043E\u0436\u0443 \u0432 \u0430\u0440\u043C\u0438\u044E.
    \u041F\u043E\u044D\u0442\u043E\u043C\u0443 - \u043E\u0431\u043D\u043E\u0432\u043B\u0435\u043D\u0438\u0435
    0.3 \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0435\u0435 \u043D\u0430 \u0434\u043E\u043B\u0433\u043E\u0435
    \u0432\u0440\u0435\u043C\u044F. \u041D\u0430\u0434\u0435\u044E\u0441\u044C, \u0447\u0442\u043E
    \u043D\u0435 \u0437\u0430\u0431\u0440\u043E\u0448\u0443 \u043F\u0440\u043E\u0435\u043A\u0442,
    \u043A\u043E\u0433\u0434\u0430 \u0432\u0435\u0440\u043D\u0443\u0441\u044C. \u0412\u0441\u0435
    \u043D\u043E\u0432\u043E\u0441\u0442\u0438 \u0431\u0443\u0434\u0443\u0442 \u0432
    \u0441\u043E\u043E\u0431\u0449\u0435\u0441\u0442\u0432\u0435 \u0432 \u0412\u041A."
