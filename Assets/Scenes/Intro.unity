  m_Text: "\u0422\u0430\u043A\u0436\u0435 \u043F\u0438\u0448\u0438\u0442\u0435 \u043D\u0430\u043C,
    \u043F\u043E \u043B\u044E\u0431\u044B\u043C \u0432\u043E\u043F\u0440\u043E\u0441\u0430\u043C,
    \u0436\u0430\u043B\u043E\u0431\u0430\u043C, \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0435\u043D\u0438\u044F\u043C.
