    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.2
  m_Text: "<color=#FF2020>\u0412\u041D\u0418\u041C\u0410\u041D\u0418\u0415!</color>\n\u0412\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435
    \u0440\u0435\u0436\u0438\u043C\u0430 \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\u0430
    \u043E\u0442\u043A\u0440\u043E\u0435\u0442 \u0434\u043E\u0441\u0442\u0443\u043F
    \u043A \u0447\u0438\u0442\u0430\u043C. \u041F\u0440\u043E\u0433\u0440\u0435\u0441\u0441
    \u0431\u0443\u0434\u0435\u0442 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0442\u044C\u0441\u044F,
    \u043D\u043E \u043A\u0430\u043A \u0442\u043E\u043B\u044C\u043A\u043E \u0432\u044B
    \u0432\u044B\u0439\u0434\u0435\u0442\u0435 \u0438\u0437 \u0440\u0435\u0436\u0438\u043C\u0430
    \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A\u0430 - \u0432\u0441\u0435
    \u0441\u043E\u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F \u0431\u0443\u0434\u0443\u0442
    \u0441\u0442\u0451\u0440\u0442\u044B. \u0422\u0440\u0438\u0436\u0434\u044B \u043F\u043E\u0434\u0443\u043C\u0430\u0439\u0442\u0435,
    \u043F\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043C \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C
    \u044D\u0442\u0443 \u0444\u0443\u043D\u043A\u0446\u0438\u044E."
